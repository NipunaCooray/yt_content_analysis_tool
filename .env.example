# Copy this file to .env and fill in your own values.
# Never commit .env with a real key.

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=

# Optional: PostgreSQL connection string. Leave unset for local SQLite (the
# default for plain local development). For local Postgres testing, prefer
# .streamlit/secrets.toml (see .streamlit/secrets.toml.example) over putting
# it here -- either works, since both are read (secrets first, then env vars).
DATABASE_URL=

# Optional: override the local SQLite database file location.
# Defaults to data/research_tool.db if unset. Ignored when DATABASE_URL is set.
DATABASE_PATH=

# Set to "production" only for the deployed Streamlit Community Cloud app
# (normally configured there via Secrets, not this file). In production, a
# missing DATABASE_URL shows a configuration error instead of silently
# falling back to SQLite. Leave unset for local development.
APP_ENV=
