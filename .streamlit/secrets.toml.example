# Copy this file to .streamlit/secrets.toml and fill in real values for
# local development against PostgreSQL. Never commit the real file --
# .streamlit/secrets.toml is already in .gitignore.
#
# For plain local SQLite development, you don't need this file at all --
# just leave DATABASE_URL unset (or use .env / YOUTUBE_API_KEY there
# instead) and the app falls back to a local SQLite file automatically.
#
# In Streamlit Community Cloud, enter these same keys under:
#   App -> Settings -> Secrets
# (not this file -- Streamlit Cloud never reads your repo's secrets.toml).

# PostgreSQL / Supabase connection string. Prefer your provider's pooled
# connection endpoint for the deployed app.
DATABASE_URL = "postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres"

YOUTUBE_API_KEY = "replace_me"

# "production" disables the local-SQLite fallback: if DATABASE_URL is also
# missing, the app shows a configuration error instead of silently using
# SQLite. Leave unset (or "development") for local work. Set this to
# "production" only in Streamlit Community Cloud's Secrets.
APP_ENV = "development"
